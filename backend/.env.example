# Local development only: synthetic values, never real credentials.
# Copy to backend/.env (ignored by git). Production values live in Coolify.
SERVER_PORT=8080
ENVIRONMENT=development
DEBUG_MODE=false
APP_TIMEZONE=Europe/Bucharest

# Application role (data only, no DDL)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=giobby_app
POSTGRES_DB_PASSWORD=dev-app-password
POSTGRES_DB_NAME=giobby
POSTGRES_DB_SSLMODE=disable

# Migration role (owner of the database), used only by cmd/migrate
MIGRATION_DB_USER=giobby
MIGRATION_DB_PASSWORD=dev-migration-password
MIGRATION_APP_ROLE=giobby_app

JWT_SECRET=dev-only-jwt-secret
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
