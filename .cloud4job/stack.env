# Docker-only commands for the go stack, run by .cloud4job/run.sh from the project root
# (PROJECT_ROOT, APP_DIR, PROJECT_NAME exported). FMT_CMD is used by the lint hook with
# {project} and {file} filled in. Module caches live in named Docker volumes.
SERVER=true
TOOLS_IMAGE=golang:1.22.12-alpine
APP_PORT=8080
HEALTHCHECK_TEST='["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]'
FMT_EXTENSIONS="go"
FMT_CMD='docker run --rm --pull=never -v "$PROJECT_ROOT":/src -w /src golang:1.22.12-alpine gofmt -w "/src/$FILE"'
GO_RUN='docker run --rm -v "$PROJECT_ROOT":/src -w "/src/$APP_DIR" -v cloud4job-go-mod:/go/pkg/mod -v cloud4job-go-build:/root/.cache/go-build golang:1.22.12-alpine'
FMT_CHECK_CMD='out=$(eval "$GO_RUN gofmt -l ."); [ -z "$out" ] || { echo "File da formattare con gofmt:"; echo "$out"; exit 1; }'
LINT_CMD='eval "$GO_RUN go vet ./..."'
# With DB=postgres the tests run inside the network of the compose test database and get
# TEST_DATABASE_URL; otherwise they run alone.
GO_RUN_DB='docker run --rm --network "container:$db" -e TEST_DATABASE_URL="postgres://postgres:dev-only-password@127.0.0.1:5432/postgres?sslmode=disable" -v "$PROJECT_ROOT":/src -w "/src/$APP_DIR" -v cloud4job-go-mod:/go/pkg/mod -v cloud4job-go-build:/root/.cache/go-build golang:1.22.12-alpine'
TEST_CMD='if [ "${DB:-none}" = postgres ]; then docker compose --profile db up -d --wait "$PROJECT_NAME-db" >/dev/null 2>&1 && db=$(docker compose --profile db ps -q "$PROJECT_NAME-db") && echo "Postgres di test: $PROJECT_NAME-db" && eval "$GO_RUN_DB go test -count=1 ./..."; else eval "$GO_RUN go test -count=1 ./..."; fi'

BUILD_CMD='docker build -t "$PROJECT_NAME:local" "$APP_DIR"'
