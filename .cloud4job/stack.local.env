# giobby overrides of the go stack commands (owned by this project, never touched by the kit).
# The image builds from the repository root (backend/Dockerfile also copies swagger.json), and
# the Go tests need a superuser DSN on a throwaway PostgreSQL of the production version.
BUILD_CMD='docker build -f backend/Dockerfile -t "$PROJECT_NAME:local" .'
TEST_CMD='db=$(docker run -d --rm -e POSTGRES_PASSWORD=test-only-password postgres:18.6-alpine) && trap "docker rm -f $db >/dev/null 2>&1" EXIT && for _ in $(seq 1 30); do docker exec "$db" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && break; sleep 1; done && echo "Postgres di test: $db" && docker run --rm --network "container:$db" -e GIOBBY_TEST_DATABASE_URL="postgres://postgres:test-only-password@127.0.0.1:5432/postgres?sslmode=disable" -v "$PROJECT_ROOT":/src -w "/src/$APP_DIR" -v cloud4job-go-mod:/go/pkg/mod -v cloud4job-go-build:/root/.cache/go-build golang:1.22.12-alpine go test -count=1 ./...'
